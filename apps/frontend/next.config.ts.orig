import type { NextConfig } from "next";

const nextConfig: NextConfig = {
  output: "standalone",
  async rewrites() {
    return [
      {
        // Allow the Next.js server (and Image optimizer) to fetch uploads
        // internally from the API container, since the optimizer requests
        // local relative URLs from itself (localhost:3000) during SSR/optimization.
        source: "/uploads/:path*",
        destination: "http://api:8080/uploads/:path*",
      },
    ];
  },
  images: {
    // remotePatterns is required for the public candidate page which receives
    // absolute URLs (http://localhost:8080/uploads/...) from the API.
    remotePatterns: [
      {
        protocol: "http",
        hostname: "**",
        pathname: "/uploads/**",
      },
      {
        protocol: "https",
        hostname: "**",
        pathname: "/uploads/**",
      },
    ],
  },
};

export default nextConfig;
