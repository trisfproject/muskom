# ==============================================================================
# MUSKOM Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file: `cp .env.example .env`
# 2. Modify values if necessary (defaults are optimized for local Docker use).
# 3. Run `docker compose up -d`
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CORE SETTINGS
# ------------------------------------------------------------------------------
# Application environment (development | staging | production)
APP_ENV=development

# The port the API will listen on internally inside the container
PORT=8080

# ------------------------------------------------------------------------------
# DATABASE & REDIS SETTINGS (Docker & Backend)
# ------------------------------------------------------------------------------
# PostgreSQL credentials (used by Postgres container initialization)
POSTGRES_USER=muskom
POSTGRES_PASSWORD=muskom_password
POSTGRES_DB=muskom

# The absolute URL for the API to connect to the DB
DATABASE_URL=postgres://muskom:muskom_password@db:5432/muskom?sslmode=disable

# Redis connection string for caching and sessions
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# SECURITY SETTINGS (Backend)
# ------------------------------------------------------------------------------
# JWT secrets used for authentication and refresh tokens.
# WARNING: Change these in a real production environment!
JWT_SECRET=muskom_rc2_secret_key
JWT_REFRESH_SECRET=muskom_rc2_refresh_secret_key
JWT_REFRESH_TTL=168h

# ------------------------------------------------------------------------------
# STORAGE SETTINGS (Backend)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ROOT=./uploads
STORAGE_BASE_URL=http://localhost:8080/uploads
# Maximum file upload size (in bytes). Default: 5MB
MAX_UPLOAD_SIZE=5242880

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (Client / SSR)
# ------------------------------------------------------------------------------
# URL used for SSR calls inside Docker network
INTERNAL_API_URL=http://api:8080/api/v1
# The base API URL exposed to the frontend browser
NEXT_PUBLIC_API_URL=/api/v1

# Feature flags for Frontend
NEXT_PUBLIC_FEATURE_ATTENDANCE=true
NEXT_PUBLIC_FEATURE_VOTING=true
NEXT_PUBLIC_FEATURE_REALTIME=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=false
NEXT_PUBLIC_FEATURE_REPORTING=false

# ------------------------------------------------------------------------------
# MAILER SETTINGS (Backend)
# ------------------------------------------------------------------------------
MAIL_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@muskom.id
SMTP_FROM_NAME="Musyawarah Komunitas"
SMTP_TLS=true
