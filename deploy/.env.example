# ==============================================================================
# MUSKOM Local Development Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file: `cp .env.example .env`
# 2. Modify values if necessary (defaults are optimized for local Docker use).
# 3. Run `docker compose up -d`
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Application environment (development | production | staging)
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------
# PostgreSQL connection parameters
POSTGRES_USER=muskom
POSTGRES_PASSWORD=muskom_password
POSTGRES_DB=muskom

# The absolute URL for the API to connect to the DB
DATABASE_URL=postgres://muskom:muskom_password@db:5432/muskom?sslmode=disable

# ------------------------------------------------------------------------------
# REDIS CACHE SETTINGS
# ------------------------------------------------------------------------------
# Redis connection string for caching and sessions
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# SECURITY SETTINGS
# ------------------------------------------------------------------------------
# JWT secrets used for authentication and refresh tokens.
# WARNING: Change these in a real production environment!
JWT_SECRET=muskom_rc2_secret_key
JWT_REFRESH_SECRET=muskom_rc2_refresh_secret_key

# ------------------------------------------------------------------------------
# CORS & NETWORKING
# ------------------------------------------------------------------------------
# Allowed origins for the API. In local dev, we allow the local domains and localhost.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://muskom.local:8080,http://admin.muskom.local:8080

# The base API URL exposed to the frontend
NEXT_PUBLIC_API_URL=/api/v1

# ------------------------------------------------------------------------------
# APPLICATION LIMITS
# ------------------------------------------------------------------------------
# Maximum file upload size (in bytes). Default: 5MB
MAX_UPLOAD_SIZE=5242880

# Application logging level (debug | info | warn | error)
LOG_LEVEL=debug
